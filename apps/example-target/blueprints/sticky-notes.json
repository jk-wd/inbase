    "notes": [
      {
        "file": "src/notes",
        "kind": "folder",
        "note": "Sticky notes board with colors, edit, pin, search, and localStorage. Plain React, no extra packages. Keep each file small."
      },
      {
        "file": "src/notes/types.ts",
        "kind": "file",
        "note": "Export Note { id, text, color, pinned, updatedAt }. Export createNote(text, color, id) with pinned false and updatedAt = Date.now()."
      },
      {
        "file": "src/notes/constants.ts",
        "kind": "file",
        "note": "Export NOTE_COLORS: a short pastel hex list (yellow, pink, mint, blue, peach). First color is the default for new notes."
      },
      {
        "file": "src/notes/utils/ids.ts",
        "kind": "file",
        "note": "Export nextId() returning a unique string. No React."
      },
      {
        "file": "src/notes/utils/storage.ts",
        "kind": "file",
        "note": "loadNotes() / saveNotes(notes) using localStorage key \"example-notes\". No React."
      },
      {
        "file": "src/notes/utils/query.ts",
        "kind": "file",
        "note": "visibleNotes(notes, query) filters by case-insensitive text match, then pinned notes first, then newest updatedAt. No React."
      },
      {
        "file": "src/notes/store/notes.ts",
        "kind": "file",
        "note": "Module state: notes and query. addNote(text, color), updateNote(id, { text?, color? }), removeNote(id), togglePin(id), setQuery(text). Persist with storage after each notes change. No React."
      },
      {
        "file": "src/notes/components/EmptyState.tsx",
        "kind": "file",
        "note": "Simple empty-board message. Accept an optional query so search-miss copy can differ. No store imports."
      },
      {
        "file": "src/notes/components/ColorPicker.tsx",
        "kind": "file",
        "note": "Row of NOTE_COLORS swatches. Props: value and onChange. Independent of the store."
      },
      {
        "file": "src/notes/components/NoteCard.tsx",
        "kind": "file",
        "note": "One note: colored card, inline text edit, ColorPicker, pin, delete. Calls updateNote, togglePin, removeNote."
      },
      {
        "file": "src/notes/components/NoteForm.tsx",
        "kind": "file",
        "note": "Textarea, ColorPicker, and Add note. Calls addNote. Independent of the board."
      },
      {
        "file": "src/notes/components/NoteSearch.tsx",
        "kind": "file",
        "note": "Search input bound to query / setQuery. Independent of the form."
      },
      {
        "file": "src/notes/components/NotesBoard.tsx",
        "kind": "file",
        "note": "Read notes and query from the store. Map NoteCard from visibleNotes. Show EmptyState when that list is empty."
      },
      {
        "file": "src/notes/NotesApp.tsx",
        "kind": "file",
        "note": "Shell that loads storage once, then renders form, search, and board."
      },
      {
        "file": "src/App.tsx",
        "kind": "file",
        "note": "Import NotesApp and render it under ColorGenerator. Keep the existing hello world."
