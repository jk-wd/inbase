@@ -0,0 +1,53 @@
+import { useEffect, useState } from 'react'
+import { Card } from '../Card'
+import {
+  fetchWeeklyVisitors,
+  type WeeklyVisitorPoint,
+} from '../../mocked-api/weeklyVisitors'
+
+export function WeeklyVisitors() {
+  const [points, setPoints] = useState<WeeklyVisitorPoint[]>([])
+  const [loading, setLoading] = useState(true)
+
+  useEffect(() => {
+    let cancelled = false
+
+    fetchWeeklyVisitors().then((nextPoints) => {
+      if (cancelled) return
+      setPoints(nextPoints)
+      setLoading(false)
+    })
+
+    return () => {
+      cancelled = true
+    }
+  }, [])
+
+  const maxVisitors = Math.max(...points.map((point) => point.visitors), 1)
+
+  return (
+    <Card title="weekly visitors">
+      <p>Mocked traffic for the past week.</p>
+      {loading ? (
+        <p>Loading visitors…</p>
+      ) : (
+        <div
+          className="graph-chart"
+          role="img"
+          aria-label="Weekly visitors bar chart"
+        >
+          {points.map((point) => (
+            <div key={point.day} className="graph-bar-wrap">
+              <span className="graph-bar-value">{point.visitors}</span>
+              <div
+                className="graph-bar"
+                style={{ height: `${(point.visitors / maxVisitors) * 100}%` }}
+              />
+              <span className="graph-bar-label">{point.day}</span>
+            </div>
+          ))}
+        </div>
+      )}
+    </Card>
+  )
+}

