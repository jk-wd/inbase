+export type WeeklyVisitorPoint = {
+  day: string
+  visitors: number
+}
+
+const WEEKLY_VISITORS: WeeklyVisitorPoint[] = [
+  { day: 'Mon', visitors: 1240 },
+  { day: 'Tue', visitors: 1580 },
+  { day: 'Wed', visitors: 1420 },
+  { day: 'Thu', visitors: 1890 },
+  { day: 'Fri', visitors: 2110 },
+  { day: 'Sat', visitors: 980 },
+  { day: 'Sun', visitors: 760 },
+]
+
+export function fetchWeeklyVisitors(): Promise<WeeklyVisitorPoint[]> {
+  return new Promise((resolve) => {
+    window.setTimeout(() => {
+      resolve(WEEKLY_VISITORS)
+    }, 240)
+  })
+}
