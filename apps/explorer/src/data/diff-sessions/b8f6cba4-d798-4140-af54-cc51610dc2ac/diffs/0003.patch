diff -u -N -r /tmp/calc-old/src/hooks/useCalculator.ts /tmp/calc-new/src/hooks/useCalculator.ts
--- /dev/null
+++ b/src/hooks/useCalculator.ts
@@ -0,0 +1,102 @@
+import { useState } from 'react'
+
+export type CalculatorOperator = '+' | '-' | '*' | '/'
+
+function compute(left: number, right: number, operator: CalculatorOperator) {
+  switch (operator) {
+    case '+':
+      return left + right
+    case '-':
+      return left - right
+    case '*':
+      return left * right
+    case '/':
+      return right === 0 ? Number.NaN : left / right
+  }
+}
+
+function formatValue(value: number) {
+  if (!Number.isFinite(value)) return 'Error'
+  return String(Number(value.toPrecision(12)))
+}
+
+export function useCalculator() {
+  const [display, setDisplay] = useState('0')
+  const [stored, setStored] = useState<number | null>(null)
+  const [operator, setOperator] = useState<CalculatorOperator | null>(null)
+  const [fresh, setFresh] = useState(true)
+
+  function inputDigit(digit: string) {
+    setDisplay((value) => (fresh || value === '0' ? digit : value + digit))
+    setFresh(false)
+  }
+
+  function inputDecimal() {
+    setDisplay((value) => {
+      if (fresh) return '0.'
+      if (value.includes('.')) return value
+      return `${value}.`
+    })
+    setFresh(false)
+  }
+
+  function applyOperator(next: CalculatorOperator) {
+    const current = Number(display)
+    if (stored !== null && operator && !fresh) {
+      const result = compute(stored, current, operator)
+      setStored(result)
+      setDisplay(formatValue(result))
+    } else {
+      setStored(current)
+    }
+    setOperator(next)
+    setFresh(true)
+  }
+
+  function equals() {
+    if (stored === null || operator === null) return
+    const result = compute(stored, Number(display), operator)
+    setDisplay(formatValue(result))
+    setStored(null)
+    setOperator(null)
+    setFresh(true)
+  }
+
+  function clear() {
+    setDisplay('0')
+    setStored(null)
+    setOperator(null)
+    setFresh(true)
+  }
+
+  function backspace() {
+    setDisplay((value) => {
+      if (fresh || value === 'Error') return '0'
+      if (value.length <= 1 || (value.startsWith('-') && value.length === 2)) return '0'
+      return value.slice(0, -1)
+    })
+  }
+
+  function toggleSign() {
+    setDisplay((value) => {
+      if (value === '0' || value === 'Error') return value
+      return value.startsWith('-') ? value.slice(1) : `-${value}`
+    })
+    setFresh(false)
+  }
+
+  const expression =
+    stored !== null && operator ? `${formatValue(stored)} ${operator}` : null
+
+  return {
+    display,
+    expression,
+    inputDigit,
+    inputDecimal,
+    applyOperator,
+    equals,
+    clear,
+    backspace,
+    toggleSign,
+  }
+}
