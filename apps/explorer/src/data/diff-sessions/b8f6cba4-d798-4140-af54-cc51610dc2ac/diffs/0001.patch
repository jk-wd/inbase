--- /dev/null
+++ b/src/components/Calculator.tsx
@@ -0,0 +1,116 @@
+import { useState } from 'react'
+import { Button } from './Button'
+import { Card } from './Card'
+
+type Operator = '+' | '-' | '*' | '/'
+
+function compute(left: number, right: number, operator: Operator) {
+  switch (operator) {
+    case '+':
+      return left + right
+    case '-':
+      return left - right
+    case '*':
+      return left * right
+    case '/':
+      return right === 0 ? Number.NaN : left / right
+  }
+}
+
+function formatValue(value: number) {
+  if (!Number.isFinite(value)) return 'Error'
+  return String(Number(value.toPrecision(12)))
+}
+
+export function Calculator() {
+  const [display, setDisplay] = useState('0')
+  const [stored, setStored] = useState<number | null>(null)
+  const [operator, setOperator] = useState<Operator | null>(null)
+  const [fresh, setFresh] = useState(true)
+
+  function inputDigit(digit: string) {
+    setDisplay((value) => (fresh || value === '0' ? digit : value + digit))
+    setFresh(false)
+  }
+
+  function inputDecimal() {
+    setDisplay((value) => {
+      if (fresh) return '0.'
+      if (value.includes('.')) return value
+      return `${value}.`
+    })
+    setFresh(false)
+  }
+
+  function applyOperator(next: Operator) {
+    const current = Number(display)
+    if (stored !== null && operator && !fresh) {
+      const result = compute(stored, current, operator)
+      setStored(result)
+      setDisplay(formatValue(result))
+    } else {
+      setStored(current)
+    }
+    setOperator(next)
+    setFresh(true)
+  }
+
+  function equals() {
+    if (stored === null || operator === null) return
+    const result = compute(stored, Number(display), operator)
+    setDisplay(formatValue(result))
+    setStored(null)
+    setOperator(null)
+    setFresh(true)
+  }
+
+  function clear() {
+    setDisplay('0')
+    setStored(null)
+    setOperator(null)
+    setFresh(true)
+  }
+
+  return (
+    <Card title="calculator">
+      <p>Current value: {display}</p>
+      <div className="ui-row">
+        <Button onClick={() => inputDigit('7')}>7</Button>
+        <Button onClick={() => inputDigit('8')}>8</Button>
+        <Button onClick={() => inputDigit('9')}>9</Button>
+        <Button variant="ghost" onClick={() => applyOperator('/')}>
+          /
+        </Button>
+      </div>
+      <div className="ui-row">
+        <Button onClick={() => inputDigit('4')}>4</Button>
+        <Button onClick={() => inputDigit('5')}>5</Button>
+        <Button onClick={() => inputDigit('6')}>6</Button>
+        <Button variant="ghost" onClick={() => applyOperator('*')}>
+          *
+        </Button>
+      </div>
+      <div className="ui-row">
+        <Button onClick={() => inputDigit('1')}>1</Button>
+        <Button onClick={() => inputDigit('2')}>2</Button>
+        <Button onClick={() => inputDigit('3')}>3</Button>
+        <Button variant="ghost" onClick={() => applyOperator('-')}>
+          -
+        </Button>
+      </div>
+      <div className="ui-row">
+        <Button onClick={() => inputDigit('0')}>0</Button>
+        <Button onClick={inputDecimal}>.</Button>
+        <Button onClick={equals}>=</Button>
+        <Button variant="ghost" onClick={() => applyOperator('+')}>
+          +
+        </Button>
+      </div>
+      <div className="ui-row">
+        <Button variant="ghost" onClick={clear}>
+          Clear
+        </Button>
+      </div>
+    </Card>
+  )
+}
